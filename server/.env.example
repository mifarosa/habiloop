# Copy to .env and fill in. Never commit .env or the service account key.

# Path to the Firebase service account key (JSON) you downloaded.
GOOGLE_APPLICATION_CREDENTIALS=/opt/habiloop/server/serviceAccount.json

# Output of `npm run vapid`. The public key is also pasted into js/push-config.js in the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if your server misbehaves.
VAPID_SUBJECT=mailto:you@example.com

# Optional
DATA_DIR=./data
TICK_SECONDS=30
MAX_LATE_MINUTES=30
